# Get a key at https://platform.claude.com/ — this is what lets the library look at
# what you save and sort it. Without it, everything lands in "Unsorted".
ANTHROPIC_API_KEY=

# Optional settings
# LIBRARY_DIR=library            # where your folders and files live (any path, e.g. an external drive)
# PORT=4321
# SORT_MODEL=claude-opus-5-5     # the model that sorts things
# SORT_EFFORT=low                # low is plenty for sorting; raise it if sorting feels off
# SORT_CONCURRENCY=3             # how many things get sorted at the same time
