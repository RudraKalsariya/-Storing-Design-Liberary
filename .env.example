# Only needed when running from source. The desktop app has a Settings screen instead.

# Optional: turns on auto-sorting. Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# LIBRARY_DIR=library            # where your folders and files live (any path, e.g. an external drive)
# PORT=4321
# SORT_MODEL=claude-opus-5-5     # claude-haiku-5-5 is much cheaper
# SORT_EFFORT=low                # low is plenty for sorting; raise it if sorting feels off
# SORT_CONCURRENCY=3             # how many things get sorted at the same time
